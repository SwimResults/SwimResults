# Copy to dev/.env (gitignored). Everything here is for LOCAL development only.

# Shared service-to-service key (any value locally; must match across services)
SR_SERVICE_KEY=local-dev-service-key

# Keycloak realm public key, so real tokens from auth.swimresults.de work against local services:
#   curl -s https://auth.swimresults.de/realms/swimresults | jq -r .public_key
# Leave empty to run without auth (protected routes then return 401).
SR_JWT_PUBLIC_KEY=

# import-service: certificate import (optional)
SR_IMPORT_OPENAI_KEY=
# any value disables the actual import calls in import-service
SR_NO_IMPORT=

# user-service: APNs sandbox endpoint
SR_APNS_URL=https://api.sandbox.push.apple.com:443
